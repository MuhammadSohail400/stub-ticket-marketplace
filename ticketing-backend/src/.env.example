PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ticketing?retryWrites=true&w=majority
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d

# Stripe
# Get your secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get your webhook secret by running: stripe listen --forward-to localhost:5000/api/orders/webhook
# or from the Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret